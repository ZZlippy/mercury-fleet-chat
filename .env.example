NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://mercury:mercury@localhost:5432/mercury
SESSION_TTL_HOURS=72
STORAGE_DIR=./var/storage
INTERPRETER=rule            # rule | anthropic
ANTHROPIC_API_KEY=          # optional; anthropic interpreter falls back to rule when absent
RFQ_REMINDER_1_MINUTES=30
RFQ_REMINDER_2_MINUTES=120
RFQ_HANDOFF_AFTER_REMINDERS=2
OUTBOX_POLL_MS=500
