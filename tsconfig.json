{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "noEmit": true,
    "types": [
      "node"
    ],
    "baseUrl": ".",
    "paths": {
      "@mercury/contracts": [
        "packages/contracts/src/index.ts"
      ],
      "@mercury/domain": [
        "packages/domain/src/index.ts"
      ],
      "@mercury/db": [
        "packages/db/src/index.ts"
      ],
      "@mercury/application": [
        "packages/application/src/index.ts"
      ],
      "@mercury/ai": [
        "packages/ai/src/index.ts"
      ],
      "@mercury/channels": [
        "packages/channels/src/index.ts"
      ]
    },
    "allowImportingTsExtensions": true,
    "lib": [
      "ES2023"
    ]
  },
  "include": [
    "packages/**/*.ts",
    "apps/api/**/*.ts",
    "apps/worker/**/*.ts",
    "scripts/**/*.ts",
    "tests/**/*.ts",
    "vitest.config.ts",
    "vitest.workspace.ts",
    "playwright.config.ts"
  ],
  "exclude": [
    "node_modules",
    "apps/web"
  ]
}