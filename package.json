{
  "name": "mercury",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "migrate": "tsx packages/db/src/migrate.ts",
    "seed": "tsx scripts/seed.ts",
    "dev:api": "tsx watch apps/api/src/main.ts",
    "start:api": "tsx apps/api/src/main.ts",
    "start:worker": "tsx apps/worker/src/main.ts",
    "build:web": "pnpm --filter @mercury/web build",
    "build:demo-fixtures": "tsx scripts/build-demo-fixtures.ts",
    "build:demo": "VITE_DEMO_MODE=true VITE_BASE_PATH=\"${DEMO_BASE_PATH:-/}\" pnpm --filter @mercury/web build && node scripts/spa-fallback.mjs apps/web/dist",
    "typecheck:server": "tsc --noEmit",
    "typecheck:web": "tsc -p apps/web/tsconfig.json --noEmit",
    "typecheck": "pnpm typecheck:server && pnpm typecheck:web",
    "lint": "eslint . --ext .ts,.tsx",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "tsx scripts/e2e-api.ts",
    "test:browser": "playwright test",
    "test:component": "vitest run --project component"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.62.0",
    "@testing-library/dom": "10",
    "@testing-library/react": "16",
    "@testing-library/user-event": "14",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "eslint": "^9.17.0",
    "jsdom": "25",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.18.0",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@fastify/cookie": "^9.4.0",
    "@fastify/multipart": "^8.3.0",
    "@fastify/static": "^7.0.4",
    "bcryptjs": "^3.0.3",
    "dotenv": "^16.4.7",
    "fastify": "^4.28.1",
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  }
}
